<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="950.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lpv.controller.CajeroDashboardController">
    <stylesheets>
        <URL value="@/org/lpv/view/style/cajerodashboardview.css" />
    </stylesheets>
    <children>
        <VBox layoutX="0.0" layoutY="0.0" prefHeight="600.0" prefWidth="180.0" spacing="10.0" styleClass="sidebar">
            <children>
                <Label text="Navegación" styleClass="sidebar-section" />
                <Label text="Menú Principal" styleClass="sidebar-heading" />
                <Label text="Ventas" styleClass="sidebar-item" />
                <Label text="Stock" styleClass="sidebar-item" />
            </children>
        </VBox>

        <Label fx:id="lblUsuarioActual" layoutX="20.0" layoutY="525.0" text="Cajero" styleClass="sidebar-user" />
        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#eventoCerrarSesion" text="Cerrar sesión" style="-fx-background-color: transparent;" styleClass="logout-button" layoutX="20.0" layoutY="555.0" />

        <Label layoutX="700.0" layoutY="15.0" text="LibreriaPaginaViva" styleClass="brand-title">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <Label layoutX="200.0" layoutY="60.0" text="Bienvenido Cajero!" styleClass="page-title">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <GridPane layoutX="200.0" layoutY="120.0" hgap="20.0" vgap="20.0">
            <children>
                <Button text="Nueva Venta" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoNuevaVenta" styleClass="dashboard-card, card-1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button text="Detalle de Ventas" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoDetalleVentas" styleClass="dashboard-card, card-2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button text="Lista de Ventas" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoListaVentas" styleClass="dashboard-card, card-3" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                <Button text="Consultar Stock Actual" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoConsultarStock" styleClass="dashboard-card, card-4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button text="Productos con Stock Bajo" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoModuloEnDesarrollo" styleClass="dashboard-card, card-5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
    </children>
</AnchorPane>
