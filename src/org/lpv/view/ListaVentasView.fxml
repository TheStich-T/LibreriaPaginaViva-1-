<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="780.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lpv.controller.ListaVentasController">
    <stylesheets><URL value="@/org/lpv/view/style/listaventasview.css" /></stylesheets>
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Lista de Ventas del Día" styleClass="page-title"><font><Font size="24.0" /></font></Label>
        <TableView fx:id="tblVentas" layoutX="30.0" layoutY="75.0" prefWidth="720.0" prefHeight="370.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="No. Venta"><cellValueFactory><PropertyValueFactory property="idVenta" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha/Hora" />
                <TableColumn fx:id="colSubtotal" prefWidth="120.0" text="Subtotal"><cellValueFactory><PropertyValueFactory property="subtotal" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colDescuento" prefWidth="110.0" text="Descuento"><cellValueFactory><PropertyValueFactory property="descuento" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total"><cellValueFactory><PropertyValueFactory property="total" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado"><cellValueFactory><PropertyValueFactory property="estado" /></cellValueFactory></TableColumn>
            </columns>
        </TableView>
        <Button layoutX="30.0" layoutY="470.0" prefWidth="120.0" text="ACTUALIZAR" onAction="#eventoActualizar" styleClass="primary-button" />
        <Button layoutX="620.0" layoutY="470.0" prefWidth="130.0" text="VOLVER" onAction="#eventoVolver" styleClass="secondary-button" />
    </children>
</AnchorPane>
