<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="950.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lpv.controller.BodegaDashboardController">
    <stylesheets>
        <URL value="@/org/lpv/view/style/bodegadashboardview.css" />
    </stylesheets>
    <children>
        <VBox layoutX="0.0" layoutY="0.0" prefHeight="600.0" prefWidth="180.0" spacing="10.0" styleClass="sidebar">
            <children>
                <Label text="Navegación" styleClass="sidebar-section" />
                <Label text="Menú Principal" styleClass="sidebar-heading" />
                <Label text="Libros" styleClass="sidebar-item" />
                <Label text="Ingresos" styleClass="sidebar-item" />
                <Label text="Salidas" styleClass="sidebar-item" />
                <Label text="Stock" styleClass="sidebar-item" />
            </children>
        </VBox>

        <Label fx:id="lblUsuarioActual" layoutX="20.0" layoutY="525.0" text="Bodega" styleClass="sidebar-user" />
        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#eventoCerrarSesion" text="Cerrar sesión" style="-fx-background-color: transparent;" styleClass="logout-button" layoutX="20.0" layoutY="555.0" />

        <Label layoutX="700.0" layoutY="15.0" text="LibreriaPaginaViva" styleClass="brand-title">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <Label layoutX="200.0" layoutY="60.0" text="Bienvenido a Bodega!" styleClass="page-title">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <GridPane layoutX="200.0" layoutY="120.0" hgap="20.0" vgap="20.0">
            <children>
                <Button text="Consultar Libros" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoConsultarLibros" styleClass="dashboard-card, card-1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button text="Crear/Modificar Libros" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoGestionarLibros" styleClass="dashboard-card, card-2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button text="Registrar Salidas" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoRegistrarSalida" styleClass="dashboard-card, card-3" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                <Button text="Consultar Stock Actual" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoConsultarStockActual" styleClass="dashboard-card, card-4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button text="Consultar Stock Bajo" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoConsultarStockBajo" styleClass="dashboard-card, card-5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button text="Registrar Ingresos" prefWidth="190.0" prefHeight="65.0" wrapText="true" onAction="#eventoRegistrarIngreso" styleClass="dashboard-card, card-6" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            </children>
        </GridPane>

        <Label layoutX="200.0" layoutY="290.0" text="Libros con stock crítico" styleClass="page-title">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label fx:id="lblContadorStockCritico" layoutX="200.0" layoutY="318.0" styleClass="field-label" text="Cargando..." />

        <TableView fx:id="tblStockCriticoDashboard" layoutX="200.0" layoutY="342.0" prefHeight="180.0" prefWidth="610.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colDashIsbn" prefWidth="140.0" text="ISBN">
                    <cellValueFactory><PropertyValueFactory property="isbn" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDashTitulo" prefWidth="220.0" text="Título">
                    <cellValueFactory><PropertyValueFactory property="titulo" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDashStockActual" prefWidth="125.0" text="Stock Actual">
                    <cellValueFactory><PropertyValueFactory property="stockActual" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDashStockMinimo" prefWidth="125.0" text="Stock Mínimo">
                    <cellValueFactory><PropertyValueFactory property="stockMinimo" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <Button fx:id="btnAbrirFicha" layoutX="200.0" layoutY="532.0" mnemonicParsing="false" onAction="#eventoAbrirFicha" prefHeight="32.0" prefWidth="240.0" styleClass="primary-button" text="Abrir ficha del libro" />
    </children>
</AnchorPane>