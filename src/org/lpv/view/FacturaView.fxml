<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="420.0"
            prefWidth="647.0"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.lpv.controller.FacturaController">
    <children>
        <Label layoutX="14.0" layoutY="14.0" prefHeight="30.0" prefWidth="200.0" text="FACTURA">
            <font>
                <Font name="Arial" size="20.0" />
            </font>
        </Label>

        <TableView fx:id="tblDetalleFactura" layoutX="233.0" layoutY="9.0" prefHeight="365.0" prefWidth="414.0">
            <columns>
                <TableColumn fx:id="colLibro" prefWidth="180.0" text="Libro" />
                <TableColumn fx:id="colCompra" prefWidth="78.0" text="Cantidad" />
                <TableColumn fx:id="colPrecio" prefWidth="78.0" text="Precio" />
                <TableColumn fx:id="colSubtotal" prefWidth="78.0" text="Subtotal" />
            </columns>
        </TableView>

        <Label layoutX="14.0" layoutY="69.0" text="No. Factura:" />
        <Label layoutX="14.0" layoutY="103.0" text="Fecha de venta:" />
        <Label layoutX="14.0" layoutY="137.0" text="Cui:" />
        <Label layoutX="14.0" layoutY="169.0" text="Cliente:" />
        <Label layoutX="14.0" layoutY="202.0" text="Correo:" />
        <Label layoutX="14.0" layoutY="235.0" text="Descuento:" />
        <Label layoutX="14.0" layoutY="269.0" text="Total Venta:" />

        <Label fx:id="lblNoFactura" layoutX="100.0" layoutY="69.0" prefHeight="17.0" prefWidth="100.0" text="0001" />
        <Label fx:id="lblFecha" layoutX="115.0" layoutY="103.0" prefHeight="17.0" prefWidth="120.0" text="DD/MM/AAAA HH:mm" />
        <Label fx:id="lblCui" layoutX="46.0" layoutY="137.0" prefHeight="17.0" prefWidth="169.0" text="0000 00000 0000" />
        <Label fx:id="lblCliente" layoutX="64.0" layoutY="169.0" prefHeight="17.0" prefWidth="150.0" text="Cliente" />
        <Label fx:id="lblCorreo" layoutX="64.0" layoutY="202.0" prefHeight="17.0" prefWidth="150.0" text="usuario@usuario.com" />
        <Label fx:id="lblDescuento" layoutX="90.0" layoutY="235.0" prefHeight="17.0" prefWidth="120.0" text="Q 0.00" />
        <Label fx:id="lblTotal" layoutX="97.0" layoutY="269.0" prefHeight="17.0" prefWidth="120.0" text="Q 0.00" style="-fx-font-weight: bold;" />

        <Button layoutX="14.0"
                layoutY="315.0"
                mnemonicParsing="false"
                onAction="#eventoCerrar"
                prefWidth="100.0"
                text="Cerrar" />
    </children>

</AnchorPane>
