<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="620.0" styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.lpv.controller.CategoriaController">
    <stylesheets>
        <URL value="@/org/lpv/view/style/editorialview.css" />
    </stylesheets>
    <children>
        <Label layoutX="180.0" layoutY="15.0" styleClass="page-title" text="Gestión de Categorías">
            <font><Font size="22.0" /></font>
        </Label>

        <TableView fx:id="tblCategorias" layoutX="30.0" layoutY="60.0" prefHeight="220.0" prefWidth="560.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colIdCategoria" prefWidth="150.0" text="ID">
                    <cellValueFactory><PropertyValueFactory property="idCategoria" /></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colNombreCategoria" prefWidth="405.0" text="Nombre de la categoría">
                    <cellValueFactory><PropertyValueFactory property="nombreCategoria" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <Label layoutX="30.0" layoutY="300.0" styleClass="field-label" text="Nombre de la categoría" />
        <TextField fx:id="txtNombreCategoria" layoutX="30.0" layoutY="322.0" prefWidth="400.0" styleClass="text-input" />

        <Button fx:id="btnAgregar"    layoutX="30.0"  layoutY="400.0" mnemonicParsing="false" onAction="#eventoAgregar"    prefHeight="30.0" prefWidth="140.0" styleClass="primary-button"   text="AGREGAR" />
        <Button fx:id="btnActualizar" layoutX="180.0" layoutY="400.0" mnemonicParsing="false" onAction="#eventoActualizar" prefHeight="30.0" prefWidth="140.0" styleClass="primary-button"   text="ACTUALIZAR" />
        <Button fx:id="btnEliminar"   layoutX="330.0" layoutY="400.0" mnemonicParsing="false" onAction="#eventoEliminar"   prefHeight="30.0" prefWidth="140.0" styleClass="secondary-button" text="ELIMINAR" />
        <Button                       layoutX="500.0" layoutY="15.0"  mnemonicParsing="false" onAction="#eventoVolver"     prefHeight="30.0" prefWidth="90.0"  styleClass="secondary-button" text="VOLVER" />

        <Label fx:id="lblMensaje" layoutX="30.0" layoutY="440.0" text="" textFill="#b5453f" />
    </children>
</AnchorPane>