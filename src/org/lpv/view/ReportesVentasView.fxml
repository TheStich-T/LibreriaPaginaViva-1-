<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lpv.controller.ReportesVentasController">
    <stylesheets>
        <URL value="@/org/lpv/view/style/reportesventasview.css" />
    </stylesheets>
    <children>
        <Label layoutX="30.0" layoutY="20.0" styleClass="page-title" text="Reportes de Ventas">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="75.0" styleClass="field-label" text="Período:" />
        <ComboBox fx:id="cmbPeriodo" layoutX="30.0" layoutY="100.0" prefWidth="180.0" styleClass="combo-box" />

        <Label layoutX="240.0" layoutY="75.0" styleClass="field-label" text="Fecha:" />

        <Button layoutX="450.0" layoutY="100.0" mnemonicParsing="false" onAction="#eventoGenerarReporte" prefWidth="180.0" styleClass="primary-button" text="GENERAR REPORTE" />

        <TableView fx:id="tblReporteVentas" layoutX="30.0" layoutY="160.0" prefHeight="320.0" prefWidth="790.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="No. Venta">
                    <cellValueFactory>
                        <PropertyValueFactory property="idVenta" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha/Hora" />
                <TableColumn fx:id="colSubtotal" prefWidth="120.0" text="Subtotal">
                    <cellValueFactory>
                        <PropertyValueFactory property="subtotal" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDescuento" prefWidth="120.0" text="Descuento">
                    <cellValueFactory>
                        <PropertyValueFactory property="descuento" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total">
                    <cellValueFactory>
                        <PropertyValueFactory property="total" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado">
                    <cellValueFactory>
                        <PropertyValueFactory property="estado" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
        <Label fx:id="lblCantidadVentas" layoutX="30.0" layoutY="500.0" styleClass="result-label" text="Cantidad de ventas: 0" />
        <Label fx:id="lblTotalVentas" layoutX="500.0" layoutY="500.0" styleClass="total-label" text="Total de ventas: Q 0.00" />

        <Button layoutX="30.0" layoutY="545.0" mnemonicParsing="false" onAction="#eventoVolver" prefWidth="120.0" styleClass="secondary-button" text="VOLVER" />
      <DatePicker fx:id="dpFecha" layoutX="233.0" layoutY="100.0" />
    </children>
</AnchorPane>
