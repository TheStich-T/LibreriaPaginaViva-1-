<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lpv.controller.LoginController">
    <stylesheets>
        <URL value="@/org/lpv/view/style/loginview.css" />
    </stylesheets>
   <children>
      <StackPane layoutX="100.0" layoutY="100.0" prefHeight="200.0" prefWidth="400.0">
         <children>
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="133.0" minWidth="10.0" prefWidth="108.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="210.0" minWidth="10.0" prefWidth="192.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="25.0" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Usuario" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Contraseña" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="txtUsuario" prefHeight="30.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <PasswordField fx:id="txtPassword" prefHeight="30.0" GridPane.columnIndex="2" GridPane.rowIndex="2" />
               </children>
            </GridPane>
         </children>
      </StackPane>
      <Label layoutX="197.0" layoutY="37.0" text="Libreria Pagina Viva">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button fx:id="btnIniciarSesion" layoutX="109.0" layoutY="311.0" mnemonicParsing="false" onAction="#eventoIniciarSesion" prefHeight="30.0" prefWidth="204.0" text="INICIAR SESIÓN" />
      <Label fx:id="lblMensaje" layoutX="197.0" layoutY="309.0" text="" textFill="#f83737" />
      <Button fx:id="btnregistrar" layoutX="328.0" layoutY="309.0" mnemonicParsing="false" onAction="#eventoRegistrarse" prefHeight="30.0" prefWidth="160.0" text="Registrar" />
   </children>
