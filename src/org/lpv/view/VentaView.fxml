<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.lpv.controller.VentaController">
    <stylesheets>
        <URL value="@/org/lpv/view/style/ventaview.css" />
    </stylesheets>
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Nueva Venta" styleClass="page-title"><font><Font size="24.0" /></font></Label>

        <Label layoutX="30.0" layoutY="60.0" text="Buscar libro (nombre o ISBN)" styleClass="field-label" />
        <TextField fx:id="txtFiltroLibro" layoutX="30.0" layoutY="80.0" prefWidth="320.0" promptText="Escribí para filtrar..." styleClass="text-input" />
        <ComboBox fx:id="cmbLibro" layoutX="360.0" layoutY="80.0" prefWidth="260.0" promptText="Seleccionar libro" />

        <Label layoutX="30.0" layoutY="125.0" text="ISBN" styleClass="field-label" />
        <TextField fx:id="txtIsbn" layoutX="30.0" layoutY="145.0" prefWidth="220.0" styleClass="text-input" />
        <Label layoutX="270.0" layoutY="125.0" text="Cantidad" styleClass="field-label" />
        <TextField fx:id="txtCantidad" layoutX="270.0" layoutY="145.0" prefWidth="100.0" styleClass="text-input" />
        <Button layoutX="390.0" layoutY="145.0" prefWidth="110.0" text="AGREGAR" onAction="#eventoAgregar" styleClass="primary-button" />
        <Button layoutX="510.0" layoutY="145.0" prefWidth="150.0" text="ACTUALIZAR CANT." onAction="#eventoCambiarCantidad" styleClass="secondary-button" />

        <TableView fx:id="tblCarrito" layoutX="30.0" layoutY="195.0" prefHeight="225.0" prefWidth="630.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colIsbn" prefWidth="190.0" text="ISBN"><cellValueFactory><PropertyValueFactory property="isbn" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colCantidad" prefWidth="110.0" text="Cantidad"><cellValueFactory><PropertyValueFactory property="cantidad" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio unitario"><cellValueFactory><PropertyValueFactory property="precioUnitario" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="colSubtotal" prefWidth="160.0" text="Subtotal"><cellValueFactory><PropertyValueFactory property="subtotal" /></cellValueFactory></TableColumn>
            </columns>
        </TableView>

        <Button layoutX="550.0" layoutY="430.0" prefWidth="110.0" text="ELIMINAR" onAction="#eventoEliminar" styleClass="danger-button" />

        <Label layoutX="700.0" layoutY="145.0" text="Datos de venta" styleClass="section-title" />
        <Label layoutX="700.0" layoutY="168.0" text="Filtrar cliente" styleClass="field-label" />
        <TextField fx:id="txtFiltroCliente" layoutX="700.0" layoutY="188.0" prefWidth="210.0" promptText="Nombre, apellido o CUI" styleClass="text-input" />
        <Label layoutX="700.0" layoutY="215.0" text="Cliente" styleClass="field-label" />
        <ComboBox fx:id="cmbCliente" layoutX="700.0" layoutY="235.0" prefWidth="210.0" promptText="Seleccionar cliente" />
        <Label layoutX="700.0" layoutY="285.0" text="CUI Cliente" styleClass="field-label" />
        <TextField fx:id="txtCuiCliente" layoutX="700.0" layoutY="305.0" prefWidth="210.0" styleClass="text-input" editable="false" />
        <Label layoutX="700.0" layoutY="355.0" text="Subtotal" styleClass="field-label" />
        <Label fx:id="lblSubtotal" layoutX="700.0" layoutY="377.0" text="Q 0.00" styleClass="amount-label" />
        <Label layoutX="700.0" layoutY="420.0" text="Total" styleClass="field-label" />
        <Label fx:id="lblTotal" layoutX="700.0" layoutY="442.0" text="Q 0.00" styleClass="total-label" />

        <Button layoutX="700.0" layoutY="485.0" prefWidth="210.0" prefHeight="42.0" text="REGISTRAR VENTA" onAction="#eventoRegistrarVenta" styleClass="primary-button" />
        <Button layoutX="700.0" layoutY="540.0" prefWidth="100.0" text="LIMPIAR" onAction="#eventoLimpiar" styleClass="secondary-button" />
        <Button layoutX="810.0" layoutY="540.0" prefWidth="100.0" text="VOLVER" onAction="#eventoVolver" styleClass="secondary-button" />
        <Label fx:id="lblMensaje" layoutX="30.0" layoutY="565.0" text="" styleClass="message-label" />
    </children>
</AnchorPane>   